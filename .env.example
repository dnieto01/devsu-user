# Copia a .env y ajusta (docker compose carga .env automáticamente):
#   cp .env.example .env

# Perfil Spring en el contenedor (prod = Postgres + Redis lock; ver README)
SPRING_PROFILES_ACTIVE=prod

# Puerto HTTP publicado del API (host → contenedor 8095)
USER_SERVER_PORT=8095

# Postgres (misma convención que devsu-account)
POSTGRES_DB=devsu
POSTGRES_USER=devsu
POSTGRES_PASSWORD=devsu
POSTGRES_PORT=5432

SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Redis: puerto en el host si necesitas un cliente desde tu máquina
REDIS_PORT_PUBLISH=6379

# Nombre de imagen local tras el build
USER_API_IMAGE_NAME=devsu-user:local

# --- Si este compose corre EN PARALELO con devsu-account (otro compose en el mismo host) ---
# Evita choque de puertos, p. ej.:
# POSTGRES_PORT=5433
# REDIS_PORT_PUBLISH=6380
# Para ambas APIs con una sola infra: ../devsu-compose/docker-compose.yml
